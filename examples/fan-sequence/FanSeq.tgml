<?xml version="1.0"?>
<?tgml version="2.0"?>
<Tgml Background="#EEF1F4" Height="880" Stretch="Uniform" Width="1300">
    <Rectangle Fill="#EEF1F4" Height="880" Left="0" Stroke="None" Top="0" Width="1300"/>
    <Rectangle Fill="#1F2A36" Height="70" Left="0" RadiusX="0" RadiusY="0" Stroke="None" StrokeWidth="1" Top="0" Width="1300"></Rectangle>
    <Text FontFamily="Arial" FontSize="26" FontWeight="Bold" HorizontalAlign="Left" Left="20" Stroke="#FFFFFF" Top="12">FAN 01</Text>
    <Text FontFamily="Arial" FontSize="12" FontWeight="Normal" HorizontalAlign="Left" Left="20" Stroke="#BFC7D0" Top="46">Start / stop sequence example</Text>
    <Text FontFamily="Arial" FontSize="24" FontWeight="Bold" HorizontalAlign="Left" Left="200" Stroke="#202124" Top="14"><Bind Name="UNIT_ST"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var m={"0":["Stopped","#FFFFFF"],"1":["Starting","#8AB4F8"],"2":["Running","#81C995"],"3":["Stopping","#FDD663"],"4":["TRIP","#F28B82"],"5":["SEQUENCE ALARM","#F28B82"]};var k=String(Math.round(new Number(evt.getValue())));var e=m[k];if(e){t.setAttribute("Content",e[0]);t.setAttribute("Stroke",e[1]);}else{t.setAttribute("Content","");}}]]></Script></Bind>-</Text>
    <Text FontFamily="Arial" FontSize="12" FontWeight="Normal" HorizontalAlign="Left" Left="200" Stroke="#BFC7D0" Top="48">step</Text>
    <Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Left" Left="232" Stroke="#202124" Top="46"><Bind Name="STEP"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var m={"0":["0  Idle","#FFFFFF"],"1":["1  Damper Open","#FFFFFF"],"2":["2  Fan Start","#FFFFFF"],"3":["3  Run","#FFFFFF"],"4":["4  Fan Stop","#FFFFFF"],"5":["5  Run-On, Damper Close","#FFFFFF"]};var k=String(Math.round(new Number(evt.getValue())));var e=m[k];if(e){t.setAttribute("Content",e[0]);t.setAttribute("Stroke",e[1]);}else{t.setAttribute("Content","");}}]]></Script></Bind>-</Text>
    <Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Left" Left="470" Stroke="#FFFFFF" Top="46"><Bind Name="STEP_T"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v.toFixed(1)+" s");}]]></Script></Bind>--</Text>
    <Text FontFamily="Arial" FontSize="11" FontWeight="Normal" HorizontalAlign="Left" Left="560" Stroke="#BFC7D0" Top="8">MODE</Text>
    <Component Clip="False" ContentHeight="34" ContentWidth="74" Height="34" Left="560" Top="26" Val="0" Width="74"><Bind Name="MODE"/><Rectangle Fill="#FFFFFF" Height="34" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="74"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="37.0" Stroke="#202124" Top="8.0">Off</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){var c=evt.getCurrentTarget();c.setAttribute("Val",String(evt.getValue()));var r=c.getElementsByTagName("Rectangle").item(0);var tx=c.getElementsByTagName("Text").item(0);var on=(Math.round(parseFloat(c.getAttribute("Val")))==0);r.setAttribute("Fill",on?"#0B57D0":"#FFFFFF");tx.setAttribute("Stroke",on?"#FFFFFF":"#202124");}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);var v=parseFloat(c.getAttribute("Val"));setValue(b.getFullBindName(),0);}]]></Script></Component>
    <Component Clip="False" ContentHeight="34" ContentWidth="74" Height="34" Left="638" Top="26" Val="0" Width="74"><Bind Name="MODE"/><Rectangle Fill="#FFFFFF" Height="34" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="74"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="37.0" Stroke="#202124" Top="8.0">On</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){var c=evt.getCurrentTarget();c.setAttribute("Val",String(evt.getValue()));var r=c.getElementsByTagName("Rectangle").item(0);var tx=c.getElementsByTagName("Text").item(0);var on=(Math.round(parseFloat(c.getAttribute("Val")))==1);r.setAttribute("Fill",on?"#0B57D0":"#FFFFFF");tx.setAttribute("Stroke",on?"#FFFFFF":"#202124");}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);var v=parseFloat(c.getAttribute("Val"));setValue(b.getFullBindName(),1);}]]></Script></Component>
    <Component Clip="False" ContentHeight="34" ContentWidth="74" Height="34" Left="716" Top="26" Val="0" Width="74"><Bind Name="MODE"/><Rectangle Fill="#FFFFFF" Height="34" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="74"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="37.0" Stroke="#202124" Top="8.0">Auto</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){var c=evt.getCurrentTarget();c.setAttribute("Val",String(evt.getValue()));var r=c.getElementsByTagName("Rectangle").item(0);var tx=c.getElementsByTagName("Text").item(0);var on=(Math.round(parseFloat(c.getAttribute("Val")))==2);r.setAttribute("Fill",on?"#0B57D0":"#FFFFFF");tx.setAttribute("Stroke",on?"#FFFFFF":"#202124");}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);var v=parseFloat(c.getAttribute("Val"));setValue(b.getFullBindName(),2);}]]></Script></Component>
    <Text FontFamily="Arial" FontSize="11" FontWeight="Normal" HorizontalAlign="Left" Left="800" Stroke="#BFC7D0" Top="8">AUTO DEMAND</Text>
    <Component Clip="False" ContentHeight="34" ContentWidth="90" Height="34" Left="800" Top="26" Val="0" Width="90"><Bind Name="AUTO"/><Rectangle Fill="#FFFFFF" Height="34" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="90"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="45.0" Stroke="#202124" Top="8.0">Schedule</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){var c=evt.getCurrentTarget();c.setAttribute("Val",String(evt.getValue()));var r=c.getElementsByTagName("Rectangle").item(0);var tx=c.getElementsByTagName("Text").item(0);var on=(Math.round(parseFloat(c.getAttribute("Val")))==1);r.setAttribute("Fill",on?"#0B57D0":"#FFFFFF");tx.setAttribute("Stroke",on?"#FFFFFF":"#202124");}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);var v=parseFloat(c.getAttribute("Val"));setValue(b.getFullBindName(),v>0.5?0:1);}]]></Script></Component>
    <Component Clip="False" ContentHeight="34" ContentWidth="90" Height="34" Left="905" Top="26" Val="0" Width="90"><Bind Name="RESET"/><Rectangle Fill="#FFFFFF" Height="34" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="90"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="45.0" Stroke="#202124" Top="8.0">Reset</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){var c=evt.getCurrentTarget();c.setAttribute("Val",String(evt.getValue()));var r=c.getElementsByTagName("Rectangle").item(0);var tx=c.getElementsByTagName("Text").item(0);}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);var v=parseFloat(c.getAttribute("Val"));setValue(b.getFullBindName(),v+1);}]]></Script></Component>
    <Component Clip="False" ContentHeight="34" ContentWidth="130" Height="34" Left="1010" Top="26" Val="0" Width="130"><Bind Name="ESTOP"/><Rectangle Fill="#FFFFFF" Height="34" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="130"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="65.0" Stroke="#202124" Top="8.0">Emergency stop</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){var c=evt.getCurrentTarget();c.setAttribute("Val",String(evt.getValue()));var r=c.getElementsByTagName("Rectangle").item(0);var tx=c.getElementsByTagName("Text").item(0);var on=(Math.round(parseFloat(c.getAttribute("Val")))==1);r.setAttribute("Fill",on?"#D93025":"#FFFFFF");tx.setAttribute("Stroke",on?"#FFFFFF":"#202124");}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);var v=parseFloat(c.getAttribute("Val"));setValue(b.getFullBindName(),v>0.5?0:1);}]]></Script></Component>
    <Text FontFamily="Arial" FontSize="11" FontWeight="Normal" HorizontalAlign="Left" Left="1160" Stroke="#BFC7D0" Top="8">ALARMS</Text>
    <Ellipse Fill="#BDC1C6" Height="18" Left="1160" Stroke="#5F6368" StrokeWidth="1" Top="30" Width="18"><Bind Attribute="Fill" Name="TRIP"><ConvertValue AttributeValue="#BDC1C6" SignalLessOrEqualTo="0"/><ConvertValue AttributeValue="#D93025" SignalMoreOrEqualTo="1"/></Bind></Ellipse>

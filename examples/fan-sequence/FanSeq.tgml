    <Rectangle Fill="#9AA0A6" Height="90" Left="190" Stroke="#3C4043" StrokeWidth="2" Top="260" Width="26"><Bind Name="DMP_POS"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var r=evt.getTarget().getParentNode();var v=new Number(evt.getValue());r.setAttribute("Fill",v>=95?"#1E8E3E":(v<=5?"#9AA0A6":"#E37400"));}]]></Script></Bind></Rectangle>

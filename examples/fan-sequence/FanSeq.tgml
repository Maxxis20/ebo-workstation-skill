    <Rectangle Fill="#FFFFFF" Height="10" Left="220" RadiusX="0" RadiusY="0" Stroke="#9AA0A6" StrokeWidth="1" Top="453" Width="200"></Rectangle>
    <Rectangle Fill="#E37400" Height="10" Left="220" Stroke="None" Top="453" Width="1"><Bind Name="SUP_PCT"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var r=evt.getTarget().getParentNode();var v=new Number(evt.getValue());if(v<0)v=0;if(v>100.0)v=100.0;r.setAttribute("Width",Math.max(1,v*200/100.0));}]]></Script></Bind></Rectangle>
    <Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Left" Left="430" Stroke="#5F6368" Top="448"><Bind Name="SUP_T"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v.toFixed(1)+" s");}]]></Script></Bind>--</Text>
    <Text FontFamily="Arial" FontSize="12" FontWeight="Normal" HorizontalAlign="Left" Left="490" Stroke="#5F6368" Top="450">Checking req.</Text>

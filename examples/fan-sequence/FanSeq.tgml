    <Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Left" Left="36" Stroke="#B06000" Top="522">TEST (fault injection)</Text>
    <Component Clip="False" ContentHeight="34" ContentWidth="200" Height="34" Left="36" Top="550" Val="0" Width="200"><Bind Name="F_DAMPER"/><Rectangle Fill="#FFFFFF" Height="34" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="200"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="100.0" Stroke="#202124" Top="8.0">Damper does not open</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){var c=evt.getCurrentTarget();c.setAttribute("Val",String(evt.getValue()));var r=c.getElementsByTagName("Rectangle").item(0);var tx=c.getElementsByTagName("Text").item(0);var on=(Math.round(parseFloat(c.getAttribute("Val")))==1);r.setAttribute("Fill",on?"#E37400":"#FFFFFF");tx.setAttribute("Stroke",on?"#FFFFFF":"#202124");}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);var v=parseFloat(c.getAttribute("Val"));setValue(b.getFullBindName(),v>0.5?0:1);}]]></Script></Component>
    <Component Clip="False" ContentHeight="34" ContentWidth="200" Height="34" Left="256" Top="550" Val="0" Width="200"><Bind Name="F_FAN"/><Rectangle Fill="#FFFFFF" Height="34" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="200"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="100.0" Stroke="#202124" Top="8.0">Fan feedback lost</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){var c=evt.getCurrentTarget();c.setAttribute("Val",String(evt.getValue()));var r=c.getElementsByTagName("Rectangle").item(0);var tx=c.getElementsByTagName("Text").item(0);var on=(Math.round(parseFloat(c.getAttribute("Val")))==1);r.setAttribute("Fill",on?"#E37400":"#FFFFFF");tx.setAttribute("Stroke",on?"#FFFFFF":"#202124");}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);var v=parseFloat(c.getAttribute("Val"));setValue(b.getFullBindName(),v>0.5?0:1);}]]></Script></Component>
    <Text FontFamily="Arial" FontSize="12" FontWeight="Normal" HorizontalAlign="Left" Left="36" Stroke="#5F6368" Top="598">Last sequence alarm: step</Text>
    <Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Left" Left="192" Stroke="#202124" Top="597"><Bind Name="AL_STEP"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var m={"0":["-","#5F6368"],"1":["1 Damper Open","#D93025"],"2":["2 Fan Start","#D93025"],"3":["3 Run","#D93025"],"4":["4 Fan Stop","#D93025"],"5":["5 Run-On, Damper Close","#D93025"]};var k=String(Math.round(new Number(evt.getValue())));var e=m[k];if(e){t.setAttribute("Content",e[0]);t.setAttribute("Stroke",e[1]);}else{t.setAttribute("Content","");}}]]></Script></Bind>-</Text>
    <Text FontFamily="Arial" FontSize="12" FontWeight="Normal" HorizontalAlign="Left" Left="400" Stroke="#5F6368" Top="598">requirement</Text>

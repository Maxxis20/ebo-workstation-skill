    <Component Clip="False" ContentHeight="56.8" ContentWidth="56.8" Height="56.8" Left="356.6" Top="276.6" Width="56.8"><Path Fill="#5F6368" PathData="M35.2,28.4 C45.8,31.0 49.5,42.8 44.3,50.6 L33.8,55.1 C38.3,50.4 37.8,39.1 33.4,33.0 Z" Stroke="#3C4043" StrokeWidth="0.8"/><Path Fill="#5F6368" PathData="M32.6,33.7 C37.2,43.7 30.3,53.9 20.9,54.6 L10.9,49.3 C17.3,49.8 25.9,42.4 27.9,35.2 Z" Stroke="#3C4043" StrokeWidth="0.8"/><Path Fill="#5F6368" PathData="M26.9,35.0 C22.0,44.8 9.6,45.8 3.3,38.9 L1.1,27.8 C4.7,33.1 15.9,35.2 22.8,32.2 Z" Stroke="#3C4043" StrokeWidth="0.8"/><Path Fill="#5F6368" PathData="M22.3,31.4 C11.6,33.6 3.1,24.6 4.5,15.3 L11.9,6.7 C10.0,12.8 15.3,22.9 21.9,26.4 Z" Stroke="#3C4043" StrokeWidth="0.8"/><Path Fill="#5F6368" PathData="M22.3,25.4 C13.9,18.5 15.7,6.2 23.7,1.5 L35.1,2.0 C29.1,4.3 24.6,14.7 25.9,22.1 Z" Stroke="#3C4043" StrokeWidth="0.8"/><Path Fill="#5F6368" PathData="M26.9,21.8 C27.1,10.8 37.8,4.6 46.5,8.0 L53.2,17.2 C47.7,13.9 36.7,16.9 31.8,22.5 Z" Stroke="#3C4043" StrokeWidth="0.8"/><Path Fill="#5F6368" PathData="M32.6,23.1 C41.3,16.4 52.8,20.9 55.6,29.8 L52.7,40.8 C51.8,34.4 42.6,27.7 35.1,27.4 Z" Stroke="#3C4043" StrokeWidth="0.8"/><Ellipse Fill="#3C4043" Height="17.0" Left="19.9" Stroke="None" Top="19.9" Width="17.0"/><Ellipse Fill="#BDC1C6" Height="6.1" Left="25.3" Stroke="None" Top="25.3" Width="6.1"/><Rotate><Animate Animation="Stop" Attribute="Angle" CalcMode="Linear" Duration="2.0" From="0" To="360"><Bind Attribute="Animation" Name="FAN_FDB"><ConvertValue AttributeValue="Stop" SignalLessOrEqualTo="0"/><ConvertValue AttributeValue="Start" SignalMoreOrEqualTo="1"/></Bind></Animate></Rotate></Component>
    <Text FontFamily="Arial" FontSize="13" FontWeight="Bold" HorizontalAlign="Left" Left="350" Stroke="#202124" Top="194">Fan TF01</Text>
    <Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Left" Left="350" Stroke="#202124" Top="214"><Bind Name="FAN_FDB"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var m={"0":["stopped","#5F6368"],"1":["running","#1E8E3E"]};var k=String(Math.round(new Number(evt.getValue())));var e=m[k];if(e){t.setAttribute("Content",e[0]);t.setAttribute("Stroke",e[1]);}else{t.setAttribute("Content","");}}]]></Script></Bind>-</Text>

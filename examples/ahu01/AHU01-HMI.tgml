    <Component Clip="False" ContentHeight="22" ContentWidth="26" Height="22" Left="1506" Step="-0.5" Top="164" Val="0" Width="26"><Bind Name="SP_Y1"/><Rectangle Fill="#E8EAED" Height="22" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="26"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="13.0" Stroke="#202124" Top="3">-</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){evt.getCurrentTarget().setAttribute("Val",String(evt.getValue()));}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);setValue(b.getFullBindName(),Math.min(35,Math.max(10,parseFloat(c.getAttribute("Val"))+parseFloat(c.getAttribute("Step")))));}]]></Script></Component>
    <Component Clip="False" ContentHeight="22" ContentWidth="26" Height="22" Left="1538" Step="0.5" Top="164" Val="0" Width="26"><Bind Name="SP_Y1"/><Rectangle Fill="#E8EAED" Height="22" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="26"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="13.0" Stroke="#202124" Top="3">+</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){evt.getCurrentTarget().setAttribute("Val",String(evt.getValue()));}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);setValue(b.getFullBindName(),Math.min(35,Math.max(10,parseFloat(c.getAttribute("Val"))+parseFloat(c.getAttribute("Step")))));}]]></Script></Component>
    <Text FontFamily="Arial" FontSize="12" FontWeight="Normal" HorizontalAlign="Left" Left="1208" Stroke="#1F2329" Top="194">  ... at extract air</Text>

    <Text FontFamily="Arial" FontSize="11" FontWeight="Normal" HorizontalAlign="Left" Left="1032" Stroke="#5F6368" Top="842">Rotor icing</Text>
    <Component Clip="False" ContentHeight="20" ContentWidth="22" Height="20" Left="1032" Step="-1" Top="858" Val="0" Width="22"><Bind Name="B_ICE"/><Rectangle Fill="#E8EAED" Height="20" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="22"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="11.0" Stroke="#202124" Top="3">0</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){evt.getCurrentTarget().setAttribute("Val",String(evt.getValue()));}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);setValue(b.getFullBindName(),Math.min(1,Math.max(0,parseFloat(c.getAttribute("Val"))+parseFloat(c.getAttribute("Step")))));}]]></Script></Component>
    <Component Clip="False" ContentHeight="20" ContentWidth="22" Height="20" Left="1058" Step="1" Top="858" Val="0" Width="22"><Bind Name="B_ICE"/><Rectangle Fill="#E8EAED" Height="20" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="22"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="11.0" Stroke="#202124" Top="3">1</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){evt.getCurrentTarget().setAttribute("Val",String(evt.getValue()));}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);setValue(b.getFullBindName(),Math.min(1,Math.max(0,parseFloat(c.getAttribute("Val"))+parseFloat(c.getAttribute("Step")))));}]]></Script></Component>
    <Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="1086" Stroke="#5F6368" Top="860"><Bind Name="B_ICE"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v>=1?"ICING":"off");t.setAttribute("Stroke",v>=1?"#D93025":"#5F6368");}]]></Script></Bind>--</Text>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="560" Top="30" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="143" Left="-142.0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="22" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="-134.0" Stroke="#202124" Top="29">Operating mode selector (AOM)</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="50">Selects how the unit runs: Off (stopped, also at</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="65">night), Manual (runs continuously) or Auto (time</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="80">schedule, extended run button and night cooling /</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="95">heating). Critical alarms stop the unit in every</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="110">position. The current state is shown as run mode:</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="125">stopped, normal, night cooling, night heating or</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="140">alarm stop.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="740" Top="30" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="143" Left="-142.0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="22" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="-134.0" Stroke="#202124" Top="29">Season selector</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="50">Selects the temperature sequence: Auto, Heating</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="65">season or Cooling season. In Auto the unit</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="80">switches to the cooling season when the previous</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="95">day's mean outdoor temperature is 11 °C or more</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="110">and back to heating at 9 °C or less. Night heating</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="125">is only possible in the heating season, night</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="140">cooling only in the cooling season.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="1568" Top="25" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="113" Left="-306" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-4" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="-298" Stroke="#202124" Top="3">Alarm reset</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="24">Resets the latched critical alarms (freeze, fire,</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="39">emergency stop, pump, heat supply, fire risk</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="54">temperatures). A reset only clears alarms whose</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="69">cause has gone; the unit then restarts by itself</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="84">if the mode selector and schedule ask for it.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="1082" Top="92" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="98" Left="-306" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-4" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="-298" Stroke="#202124" Top="3">PE2 Extract duct pressure</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="24">Static pressure (suction) in the extract duct; the</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="39">extract fan speed is controlled to its setpoint</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="54">(60 Pa). A deviation of more than 25 % for 15</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="69">minutes gives an alarm.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="977" Top="110" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="113" Left="-142.0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="22" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="-134.0" Stroke="#202124" Top="29">TE7 Extract air temperature</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="50">Temperature of the air returning from the rooms.</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="65">It sets the supply temperature setpoint, decides</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="80">on cooling recovery in summer and is the warm side</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="95">reference of the heat recovery efficiency. 50 °C</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="110">or above trips the unit as a fire risk.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="574" Top="92" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="83" Left="-142.0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="22" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="-134.0" Stroke="#202124" Top="29">Extract filter (PDE2)</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="50">Filter in the extract air that protects the heat</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="65">recovery wheel. Its condition is supervised by the</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="80">pressure drop PDE2.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="574" Top="111" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="98" Left="-142.0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="22" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="-134.0" Stroke="#202124" Top="29">PDE2 Extract filter pressure drop</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="50">Pressure difference across the extract filter.</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="65">Alarm "filter dirty" after 5 minutes above the</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="80">limit, which rises with the extract fan speed from</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="95">10 Pa at 0 % to 150 Pa at 100 %.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="414" Top="86" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="128" Left="-142.0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="22" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="-134.0" Stroke="#202124" Top="29">PDE4 Heat exchanger pressure drop</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="50">Pressure difference across the extract side of the</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="65">rotor. It rises when ice builds up. At intake</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="80">temperature 0 °C or below, a value above the limit</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="95">(100 Pa at 0 % to 300 Pa at 100 % extract fan</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="110">speed) activates frost protection: rotor speed</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="125">limited to 50 % and alarm after 3 minutes.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="326" Top="110" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="98" Left="-142.0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="22" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="-134.0" Stroke="#202124" Top="29">TE8 Exhaust air temperature</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="50">Temperature of the air leaving the heat recovery</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="65">towards the exhaust. Shown for information; a very</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="80">low value together with rising PDE4 indicates</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="95">icing of the wheel.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="210" Top="74" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="128" Left="-142.0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="22" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="-134.0" Stroke="#202124" Top="29">PF01 Extract fan</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="50">Variable speed fan that draws air from the rooms.</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="65">It is started 30 s after the dampers open and its</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="80">speed (20 ... 60 %) is controlled to hold the</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="95">extract duct pressure PE2. If it does not report</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="110">running while commanded, an alarm is given after</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="125">15 minutes.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="210" Top="126" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="83" Left="-142.0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="22" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="-134.0" Stroke="#202124" Top="29">PDE20 Extract fan flow measurement</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="50">Pressure difference at the extract fan inlet cone,</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="65">from which the extract air flow in m3/s is</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="80">calculated.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="131" Top="120" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="98" Left="22" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-4" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="30" Stroke="#202124" Top="3">FZ02 Exhaust air damper</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="24">Shut-off damper at the exhaust air outlet. It</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="39">opens and closes together with the outdoor air</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="54">damper. The extract fan is released 30 s after it</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="69">opens. Closed when stopped and on power failure.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="131" Top="490" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="143" Left="22" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-4" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="30" Stroke="#202124" Top="3">FZ01 Outdoor air damper</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="24">Shut-off damper at the outdoor air intake. It</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="39">opens as soon as the unit is started and closes</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="54">immediately when the unit stops or a critical</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="69">alarm trips. It is an open/closed damper with</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="84">spring return, so it also closes on power failure.</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="99">The fans are only released after it has had time</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="114">to open.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="166" Top="312" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="143" Left="-142.0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-149" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="-134.0" Stroke="#202124" Top="-142">TE6 Intake air temperature</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-121">Temperature of the outdoor air just behind the</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-106">intake damper, before the filters. It is the cold</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-91">side reference for the heat recovery efficiency</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-76">and enables the heat recovery frost protection at</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-61">0 °C and below. While the unit is stopped it shows</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-46">plant room temperature rather than outdoor</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-31">temperature.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="231" Top="490" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="98" Left="22" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-4" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="30" Stroke="#202124" Top="3">Supply filter stage 1 (PDE3)</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="24">First filter stage in the outdoor air. It keeps</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="39">coarse dust away from the second stage and the</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="54">coils. Its condition is supervised by the pressure</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="69">drop PDE3.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="231" Top="509" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="128" Left="22" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-4" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="30" Stroke="#202124" Top="3">PDE3 Filter pressure drop, stage 1</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="24">Pressure difference across the first supply</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="39">filter. An alarm "filter dirty" is given when the</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="54">pressure drop has been above the limit for 5</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="69">minutes; the limit rises with the supply fan speed</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="84">from 10 Pa at 0 % to 150 Pa at 100 %. The alarm</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="99">can be switched off when no filter is fitted.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="318" Top="490" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="83" Left="22" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-4" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="30" Stroke="#202124" Top="3">Supply filter stage 2 (PDE1)</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="24">Second, finer filter stage in the outdoor air,</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="39">before the heat recovery. Its condition is</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="54">supervised by the pressure drop PDE1.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="318" Top="509" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="98" Left="22" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-4" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="30" Stroke="#202124" Top="3">PDE1 Filter pressure drop, stage 2</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="24">Pressure difference across the second supply</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="39">filter. Alarm "filter dirty" after 5 minutes above</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="54">the speed dependent limit (10 Pa at 0 % to 150 Pa</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="69">at 100 % supply fan speed).</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="408" Top="492" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="143" Left="22" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-4" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="30" Stroke="#202124" Top="3">SC3 Rotary heat exchanger</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="24">Rotating wheel that transfers heat (and in summer,</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="39">cooling) from the extract air to the supply air.</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="54">Its speed 0 ... 100 % is the first stage of the</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="69">supply temperature sequence. At a cold start it</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="84">runs at 100 % for 20 minutes. When ice builds on</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="99">the extract side its speed is limited to 50 %. A</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="114">drive fault gives an alarm after 3 minutes.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="434" Top="565" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="128" Left="22" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-4" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="30" Stroke="#202124" Top="3">HRU efficiency</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="24">Calculated temperature efficiency of the heat</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="39">recovery, (TE3 - TE6) / (TE7 - TE6). Shown only</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="54">when the rotor runs above 50 % and the temperature</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="69">difference is large enough. In cold weather an</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="84">efficiency below 40 % at 90 % rotor speed or more</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="99">gives an alarm after 5 minutes.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="496" Top="312" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="83" Left="-142.0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-89" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="-134.0" Stroke="#202124" Top="-82">TE3 Temperature after heat recovery</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-61">Supply air temperature after the rotor. Used for</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-46">the heat recovery efficiency and to check that the</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-31">heating coil heats.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="606" Top="490" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="113" Left="22" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-4" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="30" Stroke="#202124" Top="3">Heating coil (HC1)</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="24">Hot water coil that heats the supply air after the</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="39">heat recovery. It is the last heating stage of the</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="54">supply temperature sequence. Its return water is</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="69">kept at least at 10 °C at all times to protect it</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="84">from freezing.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="608" Top="542" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="143" Left="22" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-4" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="30" Stroke="#202124" Top="3">P1 Heating coil pump</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="24">Circulation pump of the heating coil. It runs</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="39">continuously when the outdoor temperature is 9 °C</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="54">or below, whenever the heating valve is open, and</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="69">during freeze protection, with a 5 minute run-on.</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="84">It is exercised once a week for 1 minute. If it</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="99">does not report running within 30 s of its command</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="114">the unit stops with a critical alarm.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="490" Top="498" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="113" Left="-306" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-4" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="-298" Stroke="#202124" Top="3">TE1 Coil return water temperature</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="24">Water temperature leaving the heating coil. It is</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="39">controlled to at least 10 °C by the heating valve.</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="54">At 6 °C or below, or on a sensor fault, freeze</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="69">protection trips: the unit stops, the valve opens</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="84">fully and an alarm is given; reset is needed.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="488" Top="628" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="143" Left="-306" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-4" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="-298" Stroke="#202124" Top="3">TV1 Heating valve</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="24">Control valve of the heating coil, 0 ... 100 %. It</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="39">opens after the heat recovery has reached full</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="54">speed (in the cooling season after the rotor as</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="69">well). Independent of the sequence it opens to</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="84">keep the coil return water above 10 °C, and it</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="99">opens fully when freeze protection trips or the</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="114">pump fails.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="641" Top="312" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="113" Left="-142.0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-119" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="-134.0" Stroke="#202124" Top="-112">TE4 Temperature after heating coil</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-91">Supply air temperature after the heating coil.</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-76">With TE3 it shows the coil's heating effect; if</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-61">the heating valve is open at least 30 % but the</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-46">air warms less than 1 K, an alarm is given after 5</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-31">minutes.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="648" Top="628" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="98" Left="-306" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-4" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="-298" Stroke="#202124" Top="3">TV2 Cooling valve</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="24">Control valve of the cooling coil, 0 ... 100 %. In</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="39">the cooling season it opens when the supply air is</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="54">too warm, after the heat recovery has done what it</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="69">can. It closes when the unit stops.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="766" Top="490" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="128" Left="22" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-4" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="30" Stroke="#202124" Top="3">Cooling coil (CC1)</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="24">Water coil after the heating coil. In the cooling</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="39">season it cools the supply air with chilled water.</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="54">When the supplying plant reports warm water in the</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="69">circuit, it is used in the heating season as a</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="84">heating stage between the heat recovery and the</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="99">heating coil.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="786" Top="312" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="113" Left="-142.0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-119" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="-134.0" Stroke="#202124" Top="-112">TE5 Temperature after cooling coil</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-91">Supply air temperature after the cooling coil.</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-76">With TE4 it shows the cooling effect; if the</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-61">cooling valve is open at least 30 % but the air</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-46">cools less than 1 K, an alarm is given after 5</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-31">minutes.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="868" Top="490" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="128" Left="22" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-4" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="30" Stroke="#202124" Top="3">TF01 Supply fan</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="24">Variable speed fan that blows the treated air into</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="39">the supply duct. It is started 60 s after the</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="54">dampers open and its speed (20 ... 60 %) is</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="69">controlled to hold the supply duct pressure PE1.</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="84">If it does not report running while commanded, an</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="99">alarm is given after 15 minutes.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="868" Top="545" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="83" Left="22" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-4" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="30" Stroke="#202124" Top="3">PDE10 Supply fan flow measurement</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="24">Pressure difference at the supply fan inlet cone.</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="39">The supply air flow in m3/s is calculated from it</Text><Text FontFamily="Arial" FontSize="11" Left="30" Stroke="#202124" Top="54">with the fan's K factor and shown next to it.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="981" Top="296" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="143" Left="-142.0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-149" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="-134.0" Stroke="#202124" Top="-142">TE2 Supply air temperature</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-121">Temperature of the air going to the rooms; the</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-106">main control sensor of the unit. Its setpoint</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-91">follows the extract temperature (21.5 °C at 18 °C</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-76">extract air down to 16 °C at 23 °C). A deviation</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-61">of more than 5 K gives an alarm after 5 minutes. 6</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-46">°C or below while running trips freeze protection,</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-31">50 °C or above trips the unit as a fire risk.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="1082" Top="296" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="98" Left="-306" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-4" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="-298" Stroke="#202124" Top="3">PE1 Supply duct pressure</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="24">Static pressure in the supply duct; the supply fan</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="39">speed is controlled to its setpoint (80 Pa). A</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="54">deviation of more than 25 % from the setpoint for</Text><Text FontFamily="Arial" FontSize="11" Left="-298" Stroke="#202124" Top="69">15 minutes gives an alarm.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="188" Top="760" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="113" Left="-142.0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-119" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="-134.0" Stroke="#202124" Top="-112">TE10.1 Room temperature</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-91">Three room temperature sensors in the served zone.</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-76">Their mean (faulty sensors left out) starts and</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-61">stops night cooling (above 22 °C / below 19 °C)</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-46">and night heating (below 18 °C / above 20 °C).</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-31">Each sensor gives a fault alarm after 3 minutes.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="188" Top="784" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="113" Left="-142.0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-119" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="-134.0" Stroke="#202124" Top="-112">TE10.2 Room temperature</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-91">Three room temperature sensors in the served zone.</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-76">Their mean (faulty sensors left out) starts and</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-61">stops night cooling (above 22 °C / below 19 °C)</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-46">and night heating (below 18 °C / above 20 °C).</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-31">Each sensor gives a fault alarm after 3 minutes.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="188" Top="808" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="113" Left="-142.0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-119" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="-134.0" Stroke="#202124" Top="-112">TE10.3 Room temperature</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-91">Three room temperature sensors in the served zone.</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-76">Their mean (faulty sensors left out) starts and</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-61">stops night cooling (above 22 °C / below 19 °C)</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-46">and night heating (below 18 °C / above 20 °C).</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-31">Each sensor gives a fault alarm after 3 minutes.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="190" Top="836" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="98" Left="-142.0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-104" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="-134.0" Stroke="#202124" Top="-97">HS10 Extended run button</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-76">Push button in the zone. In automatic mode a press</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-61">runs the unit for 1 hour beyond the schedule (or</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-46">extends the current run). It has no effect when</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-31">the mode selector is Off or Manual.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="444" Top="760" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="158" Left="-142.0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-164" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="-134.0" Stroke="#202124" Top="-157">TE00 Outdoor temperature</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-136">Outdoor air temperature from a sensor outside the</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-121">building. It is used for start-up pre-heat, the</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-106">heating coil pump, the season changeover (daily</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-91">mean), night cooling and night heating, cooling</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-76">recovery and the optional fan low speed mode. A</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-61">faulty sensor gives an alarm after 3 minutes; the</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-46">unit then assumes 0 °C and does not run the night</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-31">modes.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="424" Top="815" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="98" Left="-142.0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-104" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="-134.0" Stroke="#202124" Top="-97">SB01 Emergency stop</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-76">Stop button on the unit. Pressing it stops the</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-61">unit at once with a critical alarm. After</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-46">releasing the button the unit restarts only after</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-31">an alarm reset.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="424" Top="841" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="98" Left="-142.0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-104" Width="300"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="-134.0" Stroke="#202124" Top="-97">FA01 Fire alarm</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-76">Contact from the fire alarm panel. On a fire alarm</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-61">the unit stops at once, dampers close and a</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-46">critical alarm is given. After the fire panel is</Text><Text FontFamily="Arial" FontSize="11" Left="-134.0" Stroke="#202124" Top="-31">reset, the unit needs an alarm reset to restart.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
</Tgml>

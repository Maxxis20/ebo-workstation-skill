    <Text FontFamily="Arial" FontSize="12" FontWeight="Normal" HorizontalAlign="Left" Left="644" Stroke="#1F2329" Top="762">Outdoor temperature</Text>
    <Component Clip="False" ContentHeight="22" ContentWidth="28" Height="22" Left="644" Step="-5" Top="780" Val="0" Width="28"><Bind Name="B_OT"/><Rectangle Fill="#E8EAED" Height="22" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="28"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="14.0" Stroke="#202124" Top="3">-5</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){evt.getCurrentTarget().setAttribute("Val",String(evt.getValue()));}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);setValue(b.getFullBindName(),Math.min(40,Math.max(-40,parseFloat(c.getAttribute("Val"))+parseFloat(c.getAttribute("Step")))));}]]></Script></Component>

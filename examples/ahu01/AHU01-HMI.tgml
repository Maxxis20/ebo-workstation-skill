    <Text FontFamily="Arial" FontSize="24" FontWeight="Bold" HorizontalAlign="Left" Left="20" Stroke="#FFFFFF" Top="9">AHU01</Text>
    <Text FontFamily="Arial" FontSize="12" FontWeight="Normal" HorizontalAlign="Left" Left="20" Stroke="#C5CBD3" Top="41">Supply and extract air handling unit</Text>
    <Text FontFamily="Arial" FontSize="11" FontWeight="Normal" HorizontalAlign="Left" Left="330" Stroke="#AEB6C1" Top="10">Run mode</Text>
    <Text FontFamily="Arial" FontSize="11" FontWeight="Normal" HorizontalAlign="Left" Left="500" Stroke="#AEB6C1" Top="10">Mode selector</Text>
    <Text FontFamily="Arial" FontSize="11" FontWeight="Normal" HorizontalAlign="Left" Left="660" Stroke="#AEB6C1" Top="10">Season selector</Text>
    <Text FontFamily="Arial" FontSize="11" FontWeight="Normal" HorizontalAlign="Left" Left="830" Stroke="#AEB6C1" Top="10">Season in use</Text>
    <Text FontFamily="Arial" FontSize="11" FontWeight="Normal" HorizontalAlign="Left" Left="990" Stroke="#AEB6C1" Top="10">Night cooling</Text>
    <Text FontFamily="Arial" FontSize="11" FontWeight="Normal" HorizontalAlign="Left" Left="1105" Stroke="#AEB6C1" Top="10">Night heating</Text>
    <Text FontFamily="Arial" FontSize="11" FontWeight="Normal" HorizontalAlign="Left" Left="1220" Stroke="#AEB6C1" Top="10">Cooling coil water</Text>
    <Text FontFamily="Arial" FontSize="15" FontWeight="Bold" Left="330" Stroke="#5F6368" Top="30"><Bind Name="RUN_MODE"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var i=Math.round(new Number(evt.getValue()));var w=["Stopped","Normal","Night cooling","Night heating","Alarm stop"];var c=["#C5CBD3","#5BD17F","#8AB4F8","#F6AE6B","#FF8A80"];if(i<0||i>=5){t.setAttribute("Content","? "+i);return;}t.setAttribute("Content",w[i]);t.setAttribute("Stroke",c[i]);}]]></Script></Bind>--</Text>
    <Text FontFamily="Arial" FontSize="15" FontWeight="Bold" Left="500" Stroke="#5F6368" Top="30"><Bind Name="AOM"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var i=Math.round(new Number(evt.getValue()));var w=["Off","Manual","Auto"];var c=["#FF8A80","#FDD663","#5BD17F"];if(i<0||i>=3){t.setAttribute("Content","? "+i);return;}t.setAttribute("Content",w[i]);t.setAttribute("Stroke",c[i]);}]]></Script></Bind>--</Text>
    <Component Clip="False" ContentHeight="20" ContentWidth="20" Height="20" Left="584" Step="-1" Top="27" Val="0" Width="20"><Bind Name="AOM"/><Rectangle Fill="#E8EAED" Height="20" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="20"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="10.0" Stroke="#202124" Top="3">-</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){evt.getCurrentTarget().setAttribute("Val",String(evt.getValue()));}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);setValue(b.getFullBindName(),Math.min(2,Math.max(0,parseFloat(c.getAttribute("Val"))+parseFloat(c.getAttribute("Step")))));}]]></Script></Component>
    <Component Clip="False" ContentHeight="20" ContentWidth="20" Height="20" Left="607" Step="1" Top="27" Val="0" Width="20"><Bind Name="AOM"/><Rectangle Fill="#E8EAED" Height="20" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="20"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="10.0" Stroke="#202124" Top="3">+</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){evt.getCurrentTarget().setAttribute("Val",String(evt.getValue()));}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);setValue(b.getFullBindName(),Math.min(2,Math.max(0,parseFloat(c.getAttribute("Val"))+parseFloat(c.getAttribute("Step")))));}]]></Script></Component>
    <Text FontFamily="Arial" FontSize="15" FontWeight="Bold" Left="660" Stroke="#5F6368" Top="30"><Bind Name="SEASON_SEL"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var i=Math.round(new Number(evt.getValue()));var w=["Auto","Heating","Cooling"];var c=["#5BD17F","#F6AE6B","#8AB4F8"];if(i<0||i>=3){t.setAttribute("Content","? "+i);return;}t.setAttribute("Content",w[i]);t.setAttribute("Stroke",c[i]);}]]></Script></Bind>--</Text>
    <Component Clip="False" ContentHeight="20" ContentWidth="20" Height="20" Left="764" Step="-1" Top="27" Val="0" Width="20"><Bind Name="SEASON_SEL"/><Rectangle Fill="#E8EAED" Height="20" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="20"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="10.0" Stroke="#202124" Top="3">-</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){evt.getCurrentTarget().setAttribute("Val",String(evt.getValue()));}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);setValue(b.getFullBindName(),Math.min(2,Math.max(0,parseFloat(c.getAttribute("Val"))+parseFloat(c.getAttribute("Step")))));}]]></Script></Component>
    <Component Clip="False" ContentHeight="20" ContentWidth="20" Height="20" Left="787" Step="1" Top="27" Val="0" Width="20"><Bind Name="SEASON_SEL"/><Rectangle Fill="#E8EAED" Height="20" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="20"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="10.0" Stroke="#202124" Top="3">+</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){evt.getCurrentTarget().setAttribute("Val",String(evt.getValue()));}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);setValue(b.getFullBindName(),Math.min(2,Math.max(0,parseFloat(c.getAttribute("Val"))+parseFloat(c.getAttribute("Step")))));}]]></Script></Component>
    <Text FontFamily="Arial" FontSize="15" FontWeight="Bold" Left="830" Stroke="#F6AE6B" Top="31"><Bind Name="SEASON"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v>=1?"Cooling":"Heating");t.setAttribute("Stroke",v>=1?"#8AB4F8":"#F6AE6B");}]]></Script></Bind>--</Text>
    <Text FontFamily="Arial" FontSize="15" FontWeight="Bold" Left="990" Stroke="#C5CBD3" Top="31"><Bind Name="NIGHT_COOL"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v>=1?"ACTIVE":"off");t.setAttribute("Stroke",v>=1?"#8AB4F8":"#C5CBD3");}]]></Script></Bind>--</Text>
    <Text FontFamily="Arial" FontSize="15" FontWeight="Bold" Left="1105" Stroke="#C5CBD3" Top="31"><Bind Name="NIGHT_HEAT"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v>=1?"ACTIVE":"off");t.setAttribute("Stroke",v>=1?"#F6AE6B":"#C5CBD3");}]]></Script></Bind>--</Text>
    <Text FontFamily="Arial" FontSize="15" FontWeight="Bold" Left="1220" Stroke="#8AB4F8" Top="31"><Bind Name="HEAT_MODE"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v>=1?"warm":"chilled");t.setAttribute("Stroke",v>=1?"#F6AE6B":"#8AB4F8");}]]></Script></Bind>--</Text>

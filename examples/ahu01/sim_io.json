 "test": [
  {
   "path": "TEST/OT_Manual",
   "default": -5.0,
   "unit": "degC",
   "meaning": "Outdoor temperature; with OT_Profile 1 or 2 the mean of the profile"
  },
  {
   "path": "TEST/OT_Profile",
   "default": 0,
   "unit": "",
   "meaning": "0 = OT_Manual as is, 1 = sine around OT_Manual (peak at 15:00 for a 24 h period), 2 = sawtooth (rises from mean - A to mean + A over one period)"
  },
  {
   "path": "TEST/OT_Amplitude",
   "default": 4.0,
   "unit": "",
   "meaning": "Profile amplitude A, K"
  },
  {
   "path": "TEST/OT_Period",
   "default": 24.0,
   "unit": "",
   "meaning": "Profile period, h (use a divisor of 24 so that it is continuous at midnight)"
  },
  {
   "path": "TEST/Room_Load",
   "default": 0.0,
   "unit": "",
   "meaning": "Room load dT_load added to the room temperature target, K (+2 occupancy/solar, -2 cold)"
  },
  {
   "path": "TEST/Room_Tau",
   "default": 10800.0,
   "unit": "s",
   "meaning": "Room time constant, s (10800 for tests, 183600 = 51 h as fitted)"
  },
  {
   "path": "TEST/HW_Supply_T",
   "default": 50.0,
   "unit": "degC",
   "meaning": "Heating coil water supply temperature (drop to provoke a freeze trip)"
  },
  {
   "path": "TEST/HC_Capacity",
   "default": 2.5,
   "unit": "",
   "meaning": "Heating coil size factor on the fitted effectiveness 0.16 (1 = as fitted: too small to heat alone at -5 degC)"
  },
  {
   "path": "TEST/CC_Water_T",
   "default": 7.0,
   "unit": "degC",
   "meaning": "Cooling coil water temperature (7 chilled; 30 for warm water with controller Heating_Mode = 1)"
  },
  {
   "path": "TEST/Dirt_PDE1",
   "default": 1.0,
   "unit": "",
   "meaning": "Supply filter stage 2 dirt factor (1 clean ... 2.5 dirty; alarm from about 1.75 at 60 %)"
  },
  {
   "path": "TEST/Dirt_PDE3",
   "default": 1.0,
   "unit": "",
   "meaning": "Supply filter stage 1 dirt factor"
  },
  {
   "path": "TEST/Dirt_PDE2",
   "default": 1.0,
   "unit": "",
   "meaning": "Extract filter dirt factor"
  },
  {
   "path": "TEST/Ice_Auto",
   "default": 0,
   "unit": "",
   "meaning": "1 = icing builds by the MODEL.md rule (outdoor below -5 degC and rotor above 50 %); 0 = no icing (as in the recorded data)"
  },
  {
   "path": "TEST/Ice_Force",
   "default": 0,
   "unit": "",
   "meaning": "1 = heat recovery icing builds regardless of temperature (PDE4 rises, time constant Ice_Tau)"
  },
  {
   "path": "TEST/Noise_On",
   "default": 0,
   "unit": "",
   "meaning": "1 = sensor noise on (0.03 K on temperatures, 1 % on pressures)"
  },
  {
   "path": "TEST/Settle",
   "default": 1,
   "unit": "",
   "meaning": "While 1: the first Settle_Time s after program start or after a 0 -> 1 switch all slow lags run at 20 s"
  },
  {
   "path": "TEST/Fire_Alarm",
   "default": 0,
   "unit": "",
   "meaning": "1 = fire panel contact opens (FA01 = 0)"
  },
  {
   "path": "TEST/Stop_Pressed",
   "default": 0,
   "unit": "",
   "meaning": "1 = emergency stop pressed (SB01 = 0)"
  },
  {
   "path": "TEST/HS10_Press",
   "default": 0,
   "unit": "",
   "meaning": "1 = extended run button held (HS10 = 1); set 1 then 0 for a press"
  },
  {
   "path": "TEST/Reset_Press",
   "default": 0,
   "unit": "",
   "meaning": "1 = panel reset button held (Reset_DI = 1); set 1 then 0"
  },
  {
   "path": "TEST/TF01_Fail",
   "default": 0,
   "unit": "",
   "meaning": "1 = supply fan drive trips: fan stops, TF01_Fdb = 0"
  },
  {
   "path": "TEST/PF01_Fail",
   "default": 0,
   "unit": "",
   "meaning": "1 = extract fan drive trips: fan stops, PF01_Fdb = 0"
  },
  {
   "path": "TEST/P1_Fail",
   "default": 0,
   "unit": "",
   "meaning": "1 = pump P1 fails: no circulation, P1_Fdb = 0"
  },
  {
   "path": "TEST/SC3_Fail",
   "default": 0,
   "unit": "",
   "meaning": "1 = heat exchanger drive fault: rotor stops, SC3_Fault = 0"
  },
  {
   "path": "TEST/HN_Pres_Alarm",
   "default": 0,
   "unit": "",
   "meaning": "1 = heat supply pressure alarm on PLANT/HN_Pres_In (optional binding)"
  },
  {
   "path": "TEST/HN_Temp_Alarm",
   "default": 0,

<?xml version="1.0"?>
<?tgml version="2.0"?>
<Tgml Background="#EEF0F3" Height="236" Stretch="Uniform" Width="310">
    <Rectangle Fill="#EEF0F3" Height="236" Left="0" Stroke="None" Top="0" Width="310"/>
    <Rectangle Fill="#FFFFFF" Height="176" Left="30" RadiusX="6" RadiusY="6" Stroke="#5F6368" StrokeWidth="1.5" Top="30" Width="250"></Rectangle>
    <Rectangle Fill="#263238" Height="30" Left="30" RadiusX="6" RadiusY="6" Stroke="None" StrokeWidth="1" Top="30" Width="250"></Rectangle>
    <Rectangle Fill="#263238" Height="10" Left="30" RadiusX="0" RadiusY="0" Stroke="None" StrokeWidth="1" Top="50" Width="250"></Rectangle>
    <Text FontFamily="Arial" FontSize="13" FontWeight="Bold" HorizontalAlign="Left" Left="40" Stroke="#FFFFFF" Top="37">Room 101</Text>
    <Text FontFamily="Arial" FontSize="10" FontWeight="Normal" HorizontalAlign="Right" Left="270" Stroke="#B0BEC5" Top="39">Room sensor</Text>
    <Rectangle Fill="#FFFFFF" Height="36" Left="44" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="70" Width="8"></Rectangle>
    <Rectangle Fill="#1E8E3E" Height="15.0" Left="46" Stroke="None" Top="87.0" Width="4"><Bind Name="T"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var r=evt.getTarget().getParentNode();var v=new Number(evt.getValue());var k=(v-(20.0))/((25.0)-(20.0));if(k<0)k=0;if(k>1)k=1;var a=k<0.5?[26,115,232]:[30,142,62];var b=k<0.5?[30,142,62]:[217,48,37];var q=k<0.5?k*2:(k-0.5)*2;var s="#";for(var i=0;i<3;i++){var n=Math.round(a[i]+(b[i]-a[i])*q).toString(16);s+=(n.length<2?"0":"")+n;}r.setAttribute("Fill",s);var f=(v-(10.0))/((30.0)-(10.0));if(f<0.05)f=0.05;if(f>1)f=1;var hh=30*f;r.setAttribute("Height",hh);r.setAttribute("Top",102-hh);}]]></Script></Bind></Rectangle>
    <Ellipse Fill="#1E8E3E" Height="14" Left="41" Stroke="#5F6368" StrokeWidth="1" Top="102" Width="14"><Bind Name="T"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var r=evt.getTarget().getParentNode();var v=new Number(evt.getValue());var k=(v-(20.0))/((25.0)-(20.0));if(k<0)k=0;if(k>1)k=1;var a=k<0.5?[26,115,232]:[30,142,62];var b=k<0.5?[30,142,62]:[217,48,37];var q=k<0.5?k*2:(k-0.5)*2;var s="#";for(var i=0;i<3;i++){var n=Math.round(a[i]+(b[i]-a[i])*q).toString(16);s+=(n.length<2?"0":"")+n;}r.setAttribute("Fill",s);}]]></Script></Bind></Ellipse>
    <Text FontFamily="Arial" FontSize="30" FontWeight="Bold" HorizontalAlign="Left" Left="68" Stroke="#1F2329" Top="72"><Bind Name="T"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v.toFixed(1)+" °C");}]]></Script></Bind>--</Text>
    <Line Stroke="#C9CED6" StrokeWidth="1" X1="40" X2="270" Y1="120" Y2="120"/>
    <Text FontFamily="Arial" FontSize="12" FontWeight="Normal" HorizontalAlign="Left" Left="42" Stroke="#5F6368" Top="128">Humidity</Text>
    <Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Left" Left="122" Stroke="#1F2329" Top="126"><Bind Name="RH"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v.toFixed(0)+" %");}]]></Script></Bind>--</Text>
    <Rectangle Fill="#FFFFFF" Height="9" Left="180" RadiusX="0" RadiusY="0" Stroke="#9AA0A6" StrokeWidth="1" Top="131" Width="88"></Rectangle>
    <Rectangle Fill="#1A73E8" Height="9" Left="180" Stroke="None" Top="131" Width="1"><Bind Name="RH"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var r=evt.getTarget().getParentNode();var v=new Number(evt.getValue());if(v<0)v=0;if(v>100.0)v=100.0;r.setAttribute("Width",Math.max(1,v*88/100.0));}]]></Script></Bind></Rectangle>
    <Text FontFamily="Arial" FontSize="12" FontWeight="Normal" HorizontalAlign="Left" Left="42" Stroke="#5F6368" Top="152">Battery</Text>
    <Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Left" Left="122" Stroke="#1F2329" Top="150"><Bind Name="VDD"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v.toFixed(0)+" mV");}]]></Script></Bind>--</Text>
    <Ellipse Fill="#BDC1C6" Height="14" Left="194" Stroke="#5F6368" StrokeWidth="1" Top="152" Width="14"><Bind Attribute="Fill" Name="VDD"><ConvertValue AttributeValue="#D93025" SignalLessOrEqualTo="3300"/><ConvertValue AttributeValue="#1E8E3E" SignalMoreOrEqualTo="3300.001"/></Bind></Ellipse>
    <Text FontFamily="Arial" FontSize="10" FontWeight="Normal" HorizontalAlign="Left" Left="213" Stroke="#5F6368" Top="153">low 3300</Text>
    <Text FontFamily="Arial" FontSize="12" FontWeight="Normal" HorizontalAlign="Left" Left="42" Stroke="#5F6368" Top="176">Last new value</Text>
    <Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Left" Left="138" Stroke="#1F2329" Top="174"><Bind Name="AGE"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v.toFixed(0)+" min ago");}]]></Script></Bind>--</Text>
    <Ellipse Fill="#1E8E3E" Height="14" Left="254" Stroke="#5F6368" StrokeWidth="1" Top="176" Width="14"><Bind Attribute="Fill" Name="STALE"><ConvertValue AttributeValue="#1E8E3E" SignalLessOrEqualTo="0"/><ConvertValue AttributeValue="#D93025" SignalMoreOrEqualTo="1"/></Bind></Ellipse>
    <Component Clip="False" ContentHeight="16" ContentWidth="16" Height="16" Left="286" Top="6" Width="16"><Ellipse Fill="#1A73E8" Height="16" Left="0" Stroke="None" Top="0" Width="16"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Center" Left="8.0" Stroke="#FFFFFF" Top="1">i</Text><Group Name="pop" Visibility="Hidden"><Rectangle Fill="#FFFDE7" Height="158" Left="-246" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="-4" Width="240"/><Text FontFamily="Arial" FontSize="12" FontWeight="Bold" Left="-238" Stroke="#202124" Top="3">About this sensor</Text><Text FontFamily="Arial" FontSize="11" Left="-238" Stroke="#202124" Top="24">Values are read from the sensor's BACnet</Text><Text FontFamily="Arial" FontSize="11" Left="-238" Stroke="#202124" Top="39">objects by the server. Thermometer: blue</Text><Text FontFamily="Arial" FontSize="11" Left="-238" Stroke="#202124" Top="54">at 20 °C and below, red at 25 °C and</Text><Text FontFamily="Arial" FontSize="11" Left="-238" Stroke="#202124" Top="69">above. Battery lamp: red at or below the</Text><Text FontFamily="Arial" FontSize="11" Left="-238" Stroke="#202124" Top="84">low limit. Last new value: minutes since</Text><Text FontFamily="Arial" FontSize="11" Left="-238" Stroke="#202124" Top="99">any of the three values changed; its</Text><Text FontFamily="Arial" FontSize="11" Left="-238" Stroke="#202124" Top="114">lamp turns red after 30 minutes without</Text><Text FontFamily="Arial" FontSize="11" Left="-238" Stroke="#202124" Top="129">a change.</Text></Group><Script OnMouseClick="clk"><![CDATA[function clk(evt){evt.preventDefault();var p=evt.getCurrentTarget().getChild("pop");p.setAttribute("Visibility",p.getAttribute("Visibility")=="Visible"?"Hidden":"Visible");}]]></Script></Component>
</Tgml>

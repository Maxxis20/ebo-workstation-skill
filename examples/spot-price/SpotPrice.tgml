    <Text FontFamily="Arial" FontSize="16" FontWeight="Bold" HorizontalAlign="Left" Left="286" Stroke="#0B57D0" Top="612"><Bind Name="N_BLOCK"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v.toFixed(0)+" h");}]]></Script></Bind>--</Text>
    <Component Clip="False" ContentHeight="22" ContentWidth="26" Height="22" Left="336" Step="1" Top="612" Val="0" Width="26"><Bind Name="N_BLOCK"/><Rectangle Fill="#E8EAED" Height="22" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="26"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="13.0" Stroke="#202124" Top="3">+</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){evt.getCurrentTarget().setAttribute("Val",String(evt.getValue()));}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);setValue(b.getFullBindName(),Math.min(12,Math.max(1,parseFloat(c.getAttribute("Val"))+parseFloat(c.getAttribute("Step")))));}]]></Script></Component>

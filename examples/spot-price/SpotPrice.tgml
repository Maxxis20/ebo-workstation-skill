    <Text FontFamily="Arial" FontSize="15" FontWeight="Bold" HorizontalAlign="Left" Left="170" Stroke="#202124" Top="286"><Bind Name="D_MAX"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v.toFixed(2)+"");}]]></Script></Bind>--</Text>

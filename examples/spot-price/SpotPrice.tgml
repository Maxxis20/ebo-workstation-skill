    <Text FontFamily="Arial" FontSize="14" FontWeight="Normal" HorizontalAlign="Left" Left="36" Stroke="#202124" Top="490">Price control</Text>
    <Component Clip="False" ContentHeight="34" ContentWidth="120" Height="34" Left="250" Top="482" Val="0" Width="120"><Bind Name="CTL"/><Rectangle Fill="#FFFFFF" Height="34" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="120"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="60.0" Stroke="#202124" Top="8.0">On</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){var c=evt.getCurrentTarget();c.setAttribute("Val",String(evt.getValue()));var r=c.getElementsByTagName("Rectangle").item(0);var tx=c.getElementsByTagName("Text").item(0);var on=(Math.round(parseFloat(c.getAttribute("Val")))==1);r.setAttribute("Fill",on?"#1E8E3E":"#FFFFFF");tx.setAttribute("Stroke",on?"#FFFFFF":"#202124");}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);var v=parseFloat(c.getAttribute("Val"));setValue(b.getFullBindName(),v>0.5?0:1);}]]></Script></Component>
    <Component Clip="False" ContentHeight="34" ContentWidth="100" Height="34" Left="400" Top="482" Val="0" Width="100"><Bind Name="RES"/><Rectangle Fill="#FFFFFF" Height="34" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="100"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="50.0" Stroke="#202124" Top="8.0">Hourly</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){var c=evt.getCurrentTarget();c.setAttribute("Val",String(evt.getValue()));var r=c.getElementsByTagName("Rectangle").item(0);var tx=c.getElementsByTagName("Text").item(0);var on=(Math.round(parseFloat(c.getAttribute("Val")))==0);r.setAttribute("Fill",on?"#0B57D0":"#FFFFFF");tx.setAttribute("Stroke",on?"#FFFFFF":"#202124");}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);var v=parseFloat(c.getAttribute("Val"));setValue(b.getFullBindName(),0);}]]></Script></Component>
    <Component Clip="False" ContentHeight="34" ContentWidth="110" Height="34" Left="510" Top="482" Val="0" Width="110"><Bind Name="RES"/><Rectangle Fill="#FFFFFF" Height="34" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="110"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="55.0" Stroke="#202124" Top="8.0">15 min</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){var c=evt.getCurrentTarget();c.setAttribute("Val",String(evt.getValue()));var r=c.getElementsByTagName("Rectangle").item(0);var tx=c.getElementsByTagName("Text").item(0);var on=(Math.round(parseFloat(c.getAttribute("Val")))==1);r.setAttribute("Fill",on?"#0B57D0":"#FFFFFF");tx.setAttribute("Stroke",on?"#FFFFFF":"#202124");}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);var v=parseFloat(c.getAttribute("Val"));setValue(b.getFullBindName(),1);}]]></Script></Component>

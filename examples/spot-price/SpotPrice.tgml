    <Text FontFamily="Arial" FontSize="11" FontWeight="Normal" HorizontalAlign="Left" Left="346" Stroke="#202124" Top="120"><Bind Name="UNIT"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var m={"0":["c/kWh","#202124"],"1":["EUR/MWh","#202124"]};var k=String(Math.round(new Number(evt.getValue())));var e=m[k];if(e){t.setAttribute("Content",e[0]);t.setAttribute("Stroke",e[1]);}else{t.setAttribute("Content","c/kWh");}}]]></Script></Bind>c/kWh</Text>
    <Rectangle Fill="#9AA0A6" Height="1" Left="392.0" Top="329.2" Width="20.2" Stroke="#202124" StrokeWidth="2"><Bind Name="U0"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var r=evt.getTarget().getParentNode();var v=new Number(evt.getValue());if(v<-10.0)v=-10.0;if(v>40.0)v=40.0;var h=Math.abs(v)*4.6800;r.setAttribute("Height",Math.max(1,h));r.setAttribute("Top",v>=0?329.20-h:329.20);}]]></Script></Bind><Bind Attribute="Fill" Name="C0"><ConvertValue AttributeValue="#9AA0A6" SignalEqualTo="0"/><ConvertValue AttributeValue="#1E8E3E" SignalEqualTo="1"/><ConvertValue AttributeValue="#D93025" SignalEqualTo="2"/><ConvertValue AttributeValue="#1A73E8" SignalEqualTo="3"/><ConvertValue AttributeValue="#F1F3F4" SignalEqualTo="4"/></Bind></Rectangle>
    <Text FontFamily="Arial" FontSize="11" HorizontalAlign="Center" Left="402.1" Stroke="#5F6368" Top="384"><Bind Name="L0"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var m=Math.round(new Number(evt.getValue()));var h=Math.floor(m/60),n=m%60;t.setAttribute("Content",(h<10?"0":"")+h+":"+(n<10?"0":"")+n);}]]></Script></Bind>--</Text>

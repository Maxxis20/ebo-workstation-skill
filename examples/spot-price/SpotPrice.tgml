<?xml version="1.0"?>
<?tgml version="2.0"?>
<Tgml Background="#EEF1F4" Height="880" Stretch="Uniform" Width="1300">
    <Rectangle Fill="#EEF1F4" Height="880" Left="0" Stroke="None" Top="0" Width="1300"/>
    <Rectangle Fill="#1F2933" Height="72" Left="0" RadiusX="0" RadiusY="0" Stroke="#9AA0A6" StrokeWidth="1" Top="0" Width="1300"></Rectangle>
    <Text FontFamily="Arial" FontSize="26" FontWeight="Bold" HorizontalAlign="Left" Left="20" Stroke="#FFFFFF" Top="12">SPOT PRICE LOAD</Text>
    <Text FontFamily="Arial" FontSize="12" FontWeight="Normal" HorizontalAlign="Left" Left="22" Stroke="#C4C7C5" Top="46">Storage heater run by the day-ahead price, area FI</Text>
    <Text FontFamily="Arial" FontSize="20" FontWeight="Bold" HorizontalAlign="Left" Left="470" Stroke="#202124" Top="14"><Bind Name="REASON"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var m={"0":["PRICE CONTROL OFF - normal operation","#C4C7C5"],"1":["CHOSEN HOUR - load on","#81C995"],"2":["NOT A CHOSEN HOUR - load off","#C4C7C5"],"3":["PRICE ABOVE BLOCK LIMIT - load off","#F28B82"],"4":["PRICE AT OR BELOW FORCE LIMIT - load on","#8AB4F8"],"5":["NO PRICE DATA - normal operation","#FDD663"]};var k=String(Math.round(new Number(evt.getValue())));var e=m[k];if(e){t.setAttribute("Content",e[0]);t.setAttribute("Stroke",e[1]);}else{t.setAttribute("Content","-");}}]]></Script></Bind>-</Text>
    <Text FontFamily="Arial" FontSize="12" FontWeight="Normal" HorizontalAlign="Left" Left="470" Stroke="#C4C7C5" Top="46">load</Text>
    <Ellipse Fill="#5F6368" Height="18" Left="508" Stroke="None" Top="44" Width="18"><Bind Attribute="Fill" Name="LOAD"><ConvertValue AttributeValue="#5F6368" SignalEqualTo="0"/><ConvertValue AttributeValue="#1E8E3E" SignalEqualTo="1"/></Bind></Ellipse>
    <Text FontFamily="Arial" FontSize="11" FontWeight="Normal" HorizontalAlign="Left" Left="1080" Stroke="#C4C7C5" Top="12">ALARMS  (ring = gone, not acknowledged)</Text>
    <Ellipse Fill="#BDC1C6" Height="16" Left="1080" Stroke="#5F6368" StrokeWidth="1.5" Top="34" Width="16"><Bind Attribute="Fill" Name="AL_INV"><ConvertValue AttributeValue="#BDC1C6" SignalEqualTo="0"/><ConvertValue AttributeValue="#E37400" SignalEqualTo="1"/><ConvertValue AttributeValue="#E37400" SignalEqualTo="2"/><ConvertValue AttributeValue="#FFFFFF" SignalEqualTo="3"/><ConvertValue AttributeValue="#BDC1C6" SignalMoreOrEqualTo="4"/></Bind><Bind Attribute="Stroke" Name="AL_INV"><ConvertValue AttributeValue="#5F6368" SignalEqualTo="0"/><ConvertValue AttributeValue="#5F6368" SignalEqualTo="1"/><ConvertValue AttributeValue="#5F6368" SignalEqualTo="2"/><ConvertValue AttributeValue="#E37400" SignalEqualTo="3"/><ConvertValue AttributeValue="#5F6368" SignalMoreOrEqualTo="4"/></Bind></Ellipse>
    <Text FontFamily="Arial" FontSize="12" FontWeight="Normal" HorizontalAlign="Left" Left="1104" Stroke="#FFFFFF" Top="34">no valid price</Text>
    <Ellipse Fill="#BDC1C6" Height="16" Left="1080" Stroke="#5F6368" StrokeWidth="1.5" Top="52" Width="16"><Bind Attribute="Fill" Name="AL_STOP"><ConvertValue AttributeValue="#BDC1C6" SignalEqualTo="0"/><ConvertValue AttributeValue="#E37400" SignalEqualTo="1"/><ConvertValue AttributeValue="#E37400" SignalEqualTo="2"/><ConvertValue AttributeValue="#FFFFFF" SignalEqualTo="3"/><ConvertValue AttributeValue="#BDC1C6" SignalMoreOrEqualTo="4"/></Bind><Bind Attribute="Stroke" Name="AL_STOP"><ConvertValue AttributeValue="#5F6368" SignalEqualTo="0"/><ConvertValue AttributeValue="#5F6368" SignalEqualTo="1"/><ConvertValue AttributeValue="#5F6368" SignalEqualTo="2"/><ConvertValue AttributeValue="#E37400" SignalEqualTo="3"/><ConvertValue AttributeValue="#5F6368" SignalMoreOrEqualTo="4"/></Bind></Ellipse>
    <Text FontFamily="Arial" FontSize="12" FontWeight="Normal" HorizontalAlign="Left" Left="1104" Stroke="#FFFFFF" Top="52">bridge stopped</Text>
    <Rectangle Fill="#FFFFFF" Height="330" Left="20" RadiusX="8" RadiusY="8" Stroke="#DADCE0" StrokeWidth="1" Top="92" Width="300"></Rectangle>
    <Text FontFamily="Arial" FontSize="13" FontWeight="Bold" HorizontalAlign="Left" Left="36" Stroke="#5F6368" Top="104">PRICE NOW</Text>
    <Text FontFamily="Arial" FontSize="40" FontWeight="Bold" HorizontalAlign="Left" Left="36" Stroke="#202124" Top="120"><Bind Name="PRICE"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v.toFixed(2)+"");}]]></Script></Bind>--</Text>
    <Text FontFamily="Arial" FontSize="18" FontWeight="Bold" HorizontalAlign="Left" Left="200" Stroke="#202124" Top="138"><Bind Name="UNIT"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var m={"0":["c/kWh","#202124"],"1":["EUR/MWh","#202124"]};var k=String(Math.round(new Number(evt.getValue())));var e=m[k];if(e){t.setAttribute("Content",e[0]);t.setAttribute("Stroke",e[1]);}else{t.setAttribute("Content","c/kWh");}}]]></Script></Bind>c/kWh</Text>
    <Text FontFamily="Arial" FontSize="11" FontWeight="Normal" HorizontalAlign="Left" Left="38" Stroke="#202124" Top="176"><Bind Name="RES15"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var m={"0":["this hour, VAT 0 %","#5F6368"],"1":["this quarter, VAT 0 %","#5F6368"]};var k=String(Math.round(new Number(evt.getValue())));var e=m[k];if(e){t.setAttribute("Content",e[0]);t.setAttribute("Stroke",e[1]);}else{t.setAttribute("Content","VAT 0 %");}}]]></Script></Bind>VAT 0 %</Text>
    <Text FontFamily="Arial" FontSize="13" FontWeight="Normal" HorizontalAlign="Left" Left="36" Stroke="#5F6368" Top="204">rank today</Text>
    <Text FontFamily="Arial" FontSize="16" FontWeight="Bold" HorizontalAlign="Left" Left="170" Stroke="#202124" Top="202"><Bind Name="RANK"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v.toFixed(0)+" / 24");}]]></Script></Bind>--</Text>
    <Text FontFamily="Arial" FontSize="13" FontWeight="Normal" HorizontalAlign="Left" Left="36" Stroke="#5F6368" Top="236">average today</Text>

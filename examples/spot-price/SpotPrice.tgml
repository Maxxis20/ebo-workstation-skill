    <Rectangle Fill="#9AA0A6" Height="1" Left="1237.8" Top="329.2" Width="20.2" Stroke="None"><Bind Name="U35"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var r=evt.getTarget().getParentNode();var v=new Number(evt.getValue());if(v<-10.0)v=-10.0;if(v>40.0)v=40.0;var h=Math.abs(v)*4.6800;r.setAttribute("Height",Math.max(1,h));r.setAttribute("Top",v>=0?329.20-h:329.20);}]]></Script></Bind><Bind Attribute="Fill" Name="C35"><ConvertValue AttributeValue="#9AA0A6" SignalEqualTo="0"/><ConvertValue AttributeValue="#1E8E3E" SignalEqualTo="1"/><ConvertValue AttributeValue="#D93025" SignalEqualTo="2"/><ConvertValue AttributeValue="#1A73E8" SignalEqualTo="3"/><ConvertValue AttributeValue="#F1F3F4" SignalEqualTo="4"/></Bind></Rectangle>
    <Line Stroke="#D93025" StrokeWidth="1.5" StrokeDashArray="6,4" X1="390" X2="1260.0" Y1="329.2" Y2="329.2"><Bind Name="L_BLOCK"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var l=evt.getTarget().getParentNode();var v=new Number(evt.getValue());if(v<-10.0)v=-10.0;if(v>40.0)v=40.0;var y=329.20-v*4.6800;l.setAttribute("Y1",y);l.setAttribute("Y2",y);}]]></Script></Bind></Line>
    <Line Stroke="#1A73E8" StrokeWidth="1.5" StrokeDashArray="6,4" X1="390" X2="1260.0" Y1="329.2" Y2="329.2"><Bind Name="L_FORCE"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var l=evt.getTarget().getParentNode();var v=new Number(evt.getValue());if(v<-10.0)v=-10.0;if(v>40.0)v=40.0;var y=329.20-v*4.6800;l.setAttribute("Y1",y);l.setAttribute("Y2",y);}]]></Script></Bind></Line>

    <Text FontFamily="Arial" FontSize="11" FontWeight="Normal" HorizontalAlign="Left" Left="480" Stroke="#5F6368" Top="786">(settings stay in c/kWh)</Text>
    <Text FontFamily="Arial" FontSize="11" FontWeight="Normal" HorizontalAlign="Left" Left="36" Stroke="#5F6368" Top="822">Without valid prices, or with price control off, the load follows normal operation.</Text>
    <Rectangle Fill="#FFFFFF" Height="418" Left="660" RadiusX="8" RadiusY="8" Stroke="#DADCE0" StrokeWidth="1" Top="442" Width="620"></Rectangle>
    <Text FontFamily="Arial" FontSize="13" FontWeight="Bold" HorizontalAlign="Left" Left="676" Stroke="#5F6368" Top="454">PLAN</Text>
    <Text FontFamily="Arial" FontSize="15" FontWeight="Bold" HorizontalAlign="Left" Left="676" Stroke="#202124" Top="486"><Bind Name="BMODE"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var m={"0":["N cheapest hours of today","#202124"],"1":["cheapest hours in a row: block held until it has run","#202124"]};var k=String(Math.round(new Number(evt.getValue())));var e=m[k];if(e){t.setAttribute("Content",e[0]);t.setAttribute("Stroke",e[1]);}else{t.setAttribute("Content","-");}}]]></Script></Bind>-</Text>
    <Text FontFamily="Arial" FontSize="13" FontWeight="Normal" HorizontalAlign="Left" Left="676" Stroke="#5F6368" Top="530">N-th cheapest price today</Text>
    <Text FontFamily="Arial" FontSize="15" FontWeight="Bold" HorizontalAlign="Left" Left="930" Stroke="#202124" Top="528"><Bind Name="N_PRICE"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v.toFixed(2)+"");}]]></Script></Bind>--</Text>
    <Text FontFamily="Arial" FontSize="12" FontWeight="Normal" HorizontalAlign="Left" Left="1010" Stroke="#202124" Top="530"><Bind Name="UNIT"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var m={"0":["c/kWh","#5F6368"],"1":["EUR/MWh","#5F6368"]};var k=String(Math.round(new Number(evt.getValue())));var e=m[k];if(e){t.setAttribute("Content",e[0]);t.setAttribute("Stroke",e[1]);}else{t.setAttribute("Content","c/kWh");}}]]></Script></Bind>c/kWh</Text>
    <Text FontFamily="Arial" FontSize="13" FontWeight="Normal" HorizontalAlign="Left" Left="676" Stroke="#5F6368" Top="566">block planned</Text>
    <Ellipse Fill="#BDC1C6" Height="18" Left="930" Stroke="#5F6368" StrokeWidth="1" Top="566" Width="18"><Bind Attribute="Fill" Name="PLANNED"><ConvertValue AttributeValue="#BDC1C6" SignalLessOrEqualTo="0"/><ConvertValue AttributeValue="#00796B" SignalMoreOrEqualTo="1"/></Bind></Ellipse>
    <Text FontFamily="Arial" FontSize="13" FontWeight="Normal" HorizontalAlign="Left" Left="676" Stroke="#5F6368" Top="596">starts in</Text>
    <Text FontFamily="Arial" FontSize="15" FontWeight="Bold" HorizontalAlign="Left" Left="930" Stroke="#202124" Top="594"><Bind Name="P_WAIT"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v.toFixed(0)+" h");}]]></Script></Bind>--</Text>
    <Text FontFamily="Arial" FontSize="13" FontWeight="Normal" HorizontalAlign="Left" Left="676" Stroke="#5F6368" Top="626">hours left of it</Text>
    <Text FontFamily="Arial" FontSize="15" FontWeight="Bold" HorizontalAlign="Left" Left="930" Stroke="#202124" Top="624"><Bind Name="P_LEFT"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v.toFixed(0)+" h");}]]></Script></Bind>--</Text>
    <Text FontFamily="Arial" FontSize="13" FontWeight="Normal" HorizontalAlign="Left" Left="676" Stroke="#5F6368" Top="656">running now</Text>
    <Ellipse Fill="#BDC1C6" Height="18" Left="930" Stroke="#5F6368" StrokeWidth="1" Top="656" Width="18"><Bind Attribute="Fill" Name="INBLOCK"><ConvertValue AttributeValue="#BDC1C6" SignalLessOrEqualTo="0"/><ConvertValue AttributeValue="#1E8E3E" SignalMoreOrEqualTo="1"/></Bind></Ellipse>
    <Text FontFamily="Arial" FontSize="13" FontWeight="Normal" HorizontalAlign="Left" Left="676" Stroke="#5F6368" Top="686">cheapest block now starts in</Text>
    <Text FontFamily="Arial" FontSize="15" FontWeight="Bold" HorizontalAlign="Left" Left="930" Stroke="#202124" Top="684"><Bind Name="B_IN"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v.toFixed(0)+" h");}]]></Script></Bind>--</Text>
    <Text FontFamily="Arial" FontSize="11" FontWeight="Normal" HorizontalAlign="Left" Left="676" Stroke="#5F6368" Top="730">The block is planned again only when it has run, or while it still waits when more hours</Text>
    <Text FontFamily="Arial" FontSize="11" FontWeight="Normal" HorizontalAlign="Left" Left="676" Stroke="#5F6368" Top="746">become known (tomorrow's prices, about 14:00) or N changes: no postponing for ever.</Text>
</Tgml>

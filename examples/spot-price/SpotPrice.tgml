    <Component Clip="False" ContentHeight="34" ContentWidth="190" Height="34" Left="430" Top="524" Val="0" Width="190"><Bind Name="MODE"/><Rectangle Fill="#FFFFFF" Height="34" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="190"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="95.0" Stroke="#202124" Top="8.0">Cheapest N in a row</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){var c=evt.getCurrentTarget();c.setAttribute("Val",String(evt.getValue()));var r=c.getElementsByTagName("Rectangle").item(0);var tx=c.getElementsByTagName("Text").item(0);var on=(Math.round(parseFloat(c.getAttribute("Val")))==1);r.setAttribute("Fill",on?"#0B57D0":"#FFFFFF");tx.setAttribute("Stroke",on?"#FFFFFF":"#202124");}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);var v=parseFloat(c.getAttribute("Val"));setValue(b.getFullBindName(),1);}]]></Script></Component>

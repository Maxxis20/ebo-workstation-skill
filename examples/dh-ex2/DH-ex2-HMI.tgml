    <Line Stroke="#444444" StrokeWidth="1" X1="1035" X2="1035" Y1="220" Y2="150"/>
    <Text FontFamily="Arial" FontSize="13" FontWeight="Normal" HorizontalAlign="Left" Left="710" Stroke="#5F6368" Top="90">Set value</Text>
    <Text FontFamily="Arial" FontSize="26" FontWeight="Bold" HorizontalAlign="Left" Left="710" Stroke="#188038" Top="108"><Bind Name="HEAT_SP"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v.toFixed(1)+" °C");}]]></Script></Bind>--</Text>
</Tgml>

    <Component Clip="False" ContentHeight="26" ContentWidth="60" Height="26" Left="305" Step="1" Top="444" Val="0" Width="60"><Bind Name="P1_TRIP"/><Rectangle Fill="#E8EAED" Height="26" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="60"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="30.0" Stroke="#202124" Top="3">trip</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){evt.getCurrentTarget().setAttribute("Val",String(evt.getValue()));}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);setValue(b.getFullBindName(),Math.min(1,Math.max(0,parseFloat(c.getAttribute("Val"))+parseFloat(c.getAttribute("Step")))));}]]></Script></Component>
    <Component Clip="False" ContentHeight="26" ContentWidth="60" Height="26" Left="373" Step="-1" Top="444" Val="0" Width="60"><Bind Name="P1_TRIP"/><Rectangle Fill="#E8EAED" Height="26" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="60"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="30.0" Stroke="#202124" Top="3">reset</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){evt.getCurrentTarget().setAttribute("Val",String(evt.getValue()));}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);setValue(b.getFullBindName(),Math.min(1,Math.max(0,parseFloat(c.getAttribute("Val"))+parseFloat(c.getAttribute("Step")))));}]]></Script></Component>
    <Text FontFamily="Arial" FontSize="13" FontWeight="Bold" Left="449" Stroke="#5F6368" Top="449"><Bind Name="P1_TRIP"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v>=1?"TRIPPED":"healthy");t.setAttribute("Stroke",v>=1?"#D93025":"#5F6368");}]]></Script></Bind>--</Text>

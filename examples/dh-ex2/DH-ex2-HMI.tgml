<?xml version="1.0"?>
<?tgml version="2.0"?>
<Tgml Background="#F4F5F7" Height="600" Stretch="Uniform" Width="1100">
    <Rectangle Fill="#F4F5F7" Height="600" Left="0" Stroke="None" Top="0" Width="1100"/>
    <Text FontFamily="Arial" FontSize="20" FontWeight="Bold" HorizontalAlign="Left" Left="20" Stroke="#202124" Top="12">DH-ex2  District heating substation: domestic hot water and heating</Text>
    <Rectangle Fill="#FFFFFF" Height="200" Left="20" RadiusX="8" RadiusY="8" Stroke="#9AA0A6" StrokeWidth="1" Top="50" Width="250"/>
    <Text FontFamily="Arial" FontSize="15" FontWeight="Bold" HorizontalAlign="Left" Left="34" Stroke="#202124" Top="60">Outdoor temperature</Text>
    <Text FontFamily="Arial" FontSize="13" FontWeight="Normal" HorizontalAlign="Left" Left="34" Stroke="#5F6368" Top="80">model, click to change</Text>
    <Text FontFamily="Arial" FontSize="26" FontWeight="Bold" HorizontalAlign="Left" Left="34" Stroke="#0B57D0" Top="98"><Bind Name="TOUT"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v.toFixed(1)+" °C");}]]></Script></Bind>--</Text>
    <Component Clip="False" ContentHeight="26" ContentWidth="42" Height="26" Left="34" Step="-5" Top="136" Val="0" Width="42"><Bind Name="TOUT"/><Rectangle Fill="#E8EAED" Height="26" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="42"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="21.0" Stroke="#202124" Top="3">−5</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){evt.getCurrentTarget().setAttribute("Val",String(evt.getValue()));}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);setValue(b.getFullBindName(),Math.min(50,Math.max(-50,parseFloat(c.getAttribute("Val"))+parseFloat(c.getAttribute("Step")))));}]]></Script></Component>
    <Component Clip="False" ContentHeight="26" ContentWidth="42" Height="26" Left="84" Step="-1" Top="136" Val="0" Width="42"><Bind Name="TOUT"/><Rectangle Fill="#E8EAED" Height="26" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="42"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="21.0" Stroke="#202124" Top="3">−1</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){evt.getCurrentTarget().setAttribute("Val",String(evt.getValue()));}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);setValue(b.getFullBindName(),Math.min(50,Math.max(-50,parseFloat(c.getAttribute("Val"))+parseFloat(c.getAttribute("Step")))));}]]></Script></Component>
    <Component Clip="False" ContentHeight="26" ContentWidth="42" Height="26" Left="134" Step="1" Top="136" Val="0" Width="42"><Bind Name="TOUT"/><Rectangle Fill="#E8EAED" Height="26" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="42"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="21.0" Stroke="#202124" Top="3">+1</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){evt.getCurrentTarget().setAttribute("Val",String(evt.getValue()));}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);setValue(b.getFullBindName(),Math.min(50,Math.max(-50,parseFloat(c.getAttribute("Val"))+parseFloat(c.getAttribute("Step")))));}]]></Script></Component>
    <Component Clip="False" ContentHeight="26" ContentWidth="42" Height="26" Left="184" Step="5" Top="136" Val="0" Width="42"><Bind Name="TOUT"/><Rectangle Fill="#E8EAED" Height="26" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="42"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="21.0" Stroke="#202124" Top="3">+5</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){evt.getCurrentTarget().setAttribute("Val",String(evt.getValue()));}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);setValue(b.getFullBindName(),Math.min(50,Math.max(-50,parseFloat(c.getAttribute("Val"))+parseFloat(c.getAttribute("Step")))));}]]></Script></Component>
    <Text FontFamily="Arial" FontSize="13" FontWeight="Normal" HorizontalAlign="Left" Left="34" Stroke="#5F6368" Top="174">controller TE2B</Text>
    <Text FontFamily="Arial" FontSize="15" FontWeight="Bold" HorizontalAlign="Left" Left="150" Stroke="#0B57D0" Top="172"><Bind Name="TE2B"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v.toFixed(1)+" °C");}]]></Script></Bind>--</Text>
    <Text FontFamily="Arial" FontSize="13" FontWeight="Normal" HorizontalAlign="Left" Left="34" Stroke="#5F6368" Top="196">filtered TE2B_F</Text>
    <Text FontFamily="Arial" FontSize="15" FontWeight="Bold" HorizontalAlign="Left" Left="150" Stroke="#0B57D0" Top="194"><Bind Name="TE2B_F"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v.toFixed(1)+" °C");}]]></Script></Bind>--</Text>
    <Text FontFamily="Arial" FontSize="13" FontWeight="Normal" HorizontalAlign="Left" Left="34" Stroke="#5F6368" Top="220">Summer stop</Text>
    <Text FontFamily="Arial" FontSize="13" FontWeight="Bold" Left="150" Stroke="#5F6368" Top="220"><Bind Name="SUMMER"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v>=1?"ACTIVE":"off");t.setAttribute("Stroke",v>=1?"#F29900":"#5F6368");}]]></Script></Bind>--</Text>

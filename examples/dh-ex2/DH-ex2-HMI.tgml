    <Text FontFamily="Arial" FontSize="15" FontWeight="Bold" HorizontalAlign="Left" Left="377" Stroke="#0B57D0" Top="240"><Bind Name="TV1"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v.toFixed(1)+" %");}]]></Script></Bind>--</Text>

    <Rectangle Fill="#F29900" Height="10" Left="345" Stroke="None" Top="266" Width="1"><Bind Name="TV1"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var r=evt.getTarget().getParentNode();var v=new Number(evt.getValue());if(v<0)v=0;if(v>100.0)v=100.0;r.setAttribute("Width",Math.max(1,v*90/100.0));}]]></Script></Bind></Rectangle>

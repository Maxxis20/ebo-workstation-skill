    <Text FontFamily="Arial" FontSize="13" FontWeight="Normal" HorizontalAlign="Left" Left="958" Stroke="#5F6368" Top="368">heating return</Text>
    <Rectangle Fill="#E8EAED" Height="180" Left="860" RadiusX="0" RadiusY="0" Stroke="#3C4043" StrokeWidth="2" Top="190" Width="60"/>
    <Line Stroke="#3C4043" StrokeWidth="2" X1="860" X2="920" Y1="370" Y2="190"/>
    <Text FontFamily="Arial" FontSize="13" FontWeight="Normal" HorizontalAlign="Left" Left="710" Stroke="#5F6368" Top="156">district heating supply</Text>
    <Text FontFamily="Arial" FontSize="13" FontWeight="Normal" HorizontalAlign="Left" Left="710" Stroke="#5F6368" Top="350">district heating return</Text>
    <Text FontFamily="Arial" FontSize="13" FontWeight="Normal" HorizontalAlign="Left" Left="930" Stroke="#5F6368" Top="192">heating supply</Text>
    <Text FontFamily="Arial" FontSize="13" FontWeight="Normal" HorizontalAlign="Left" Left="710" Stroke="#5F6368" Top="422">Pump P2 motor protection (model)</Text>
    <Component Clip="False" ContentHeight="26" ContentWidth="60" Height="26" Left="710" Step="1" Top="444" Val="0" Width="60"><Bind Name="P2_TRIP"/><Rectangle Fill="#E8EAED" Height="26" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="60"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="30.0" Stroke="#202124" Top="3">trip</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){evt.getCurrentTarget().setAttribute("Val",String(evt.getValue()));}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);setValue(b.getFullBindName(),Math.min(1,Math.max(0,parseFloat(c.getAttribute("Val"))+parseFloat(c.getAttribute("Step")))));}]]></Script></Component>
    <Component Clip="False" ContentHeight="26" ContentWidth="60" Height="26" Left="778" Step="-1" Top="444" Val="0" Width="60"><Bind Name="P2_TRIP"/><Rectangle Fill="#E8EAED" Height="26" Left="0" RadiusX="4" RadiusY="4" Stroke="#5F6368" StrokeWidth="1" Top="0" Width="60"/><Text FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlign="Center" Left="30.0" Stroke="#202124" Top="3">reset</Text><Script OnMouseClick="clk" OnSignalChange="sig"><![CDATA[function sig(evt){evt.getCurrentTarget().setAttribute("Val",String(evt.getValue()));}function clk(evt){evt.preventDefault();var c=evt.getCurrentTarget();var b=c.getElementsByTagName("Bind").item(0);setValue(b.getFullBindName(),Math.min(1,Math.max(0,parseFloat(c.getAttribute("Val"))+parseFloat(c.getAttribute("Step")))));}]]></Script></Component>
    <Text FontFamily="Arial" FontSize="13" FontWeight="Bold" Left="854" Stroke="#5F6368" Top="449"><Bind Name="P2_TRIP"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v>=1?"TRIPPED":"healthy");t.setAttribute("Stroke",v>=1?"#D93025":"#5F6368");}]]></Script></Bind>--</Text>
    <Polygon Fill="#FFFFFF" Points="767,207.4 785,220 767,232.6" Stroke="#444444" StrokeWidth="1.5"></Polygon>
    <Polygon Fill="#FFFFFF" Points="803,207.4 785,220 803,232.6" Stroke="#444444" StrokeWidth="1.5"></Polygon>
    <Line Stroke="#444444" StrokeWidth="2" X1="785" X2="785" Y1="220" Y2="198.4"/>
    <Rectangle Fill="#E8EAED" Height="14.4" Left="774.2" RadiusX="0" RadiusY="0" Stroke="#444444" StrokeWidth="1" Top="184.0" Width="21.599999999999998"/>
    <Text FontFamily="Arial" FontSize="13" FontWeight="Bold" HorizontalAlign="Left" Left="750" Stroke="#202124" Top="242">TV2</Text>
    <Text FontFamily="Arial" FontSize="15" FontWeight="Bold" HorizontalAlign="Left" Left="782" Stroke="#0B57D0" Top="240"><Bind Name="TV2"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v.toFixed(1)+" %");}]]></Script></Bind>--</Text>
    <Rectangle Fill="#FFFFFF" Height="10" Left="750" RadiusX="0" RadiusY="0" Stroke="#9AA0A6" StrokeWidth="1" Top="266" Width="90"/>
    <Rectangle Fill="#F29900" Height="10" Left="750" Stroke="None" Top="266" Width="1"><Bind Name="TV2"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var r=evt.getTarget().getParentNode();var v=new Number(evt.getValue());if(v<0)v=0;if(v>100.0)v=100.0;r.setAttribute("Width",Math.max(1,v*90/100.0));}]]></Script></Bind></Rectangle>
    <Text FontFamily="Arial" FontSize="11" FontWeight="Normal" HorizontalAlign="Left" Left="750" Stroke="#5F6368" Top="284">model position</Text>
    <Text FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlign="Left" Left="750" Stroke="#5F6368" Top="298"><Bind Name="TV2_POS"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v.toFixed(1)+" %");}]]></Script></Bind>--</Text>
    <Text FontFamily="Arial" FontSize="13" FontWeight="Normal" HorizontalAlign="Left" Left="940" Stroke="#5F6368" Top="90">TE2A supply</Text>
    <Text FontFamily="Arial" FontSize="26" FontWeight="Bold" HorizontalAlign="Left" Left="940" Stroke="#0B57D0" Top="108"><Bind Name="TE2A"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v.toFixed(1)+" °C");}]]></Script></Bind>--</Text>
    <Line Stroke="#444444" StrokeWidth="1" X1="1035" X2="1035" Y1="220" Y2="150"/>
    <Text FontFamily="Arial" FontSize="13" FontWeight="Normal" HorizontalAlign="Left" Left="710" Stroke="#5F6368" Top="90">Set value</Text>

    <Text FontFamily="Arial" FontSize="13" FontWeight="Bold" Left="604" Stroke="#5F6368" Top="304"><Bind Name="P1_ON"><Script OnSignalChange="signal"><![CDATA[function signal(evt){var t=evt.getTarget().getParentNode();var v=new Number(evt.getValue());t.setAttribute("Content",v>=1?"RUN":"STOP");t.setAttribute("Stroke",v>=1?"#1E8E3E":"#5F6368");}]]></Script></Bind>--</Text>
